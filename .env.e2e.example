# SurgePilot real-IP E2E overrides.
# Copy to your shell/export as needed; do not commit real secrets.

# Required for real-IP SSH/Taurus E2E evidence. Use the host/LAN IP reachable
# from Docker containers and SSH Load Node containers.
SURGEPILOT_E2E_HOST_IP=192.168.1.20

# Platform API orchestration URL used by the host-side verifier.
SURGEPILOT_E2E_API_ORCHESTRATION_URL=http://192.168.1.20:8000

# Final SurgePilot API origin used by the Runner from the Load Node network.
# This is deliberately separate from the host-side orchestration URL.
SURGEPILOT_NODE_API_BASE_URL=http://192.168.1.20:8000

# Independent business target under test. Do not point this at SurgePilot's
# /api/healthz when collecting real-IP target evidence.
SURGEPILOT_E2E_TARGET_URL=http://192.168.1.20:18080/health

# SSH Load Node published endpoint used when the node is the compose SSH
# container but must be registered through the host IP.
SURGEPILOT_E2E_NODE_SSH_HOST=192.168.1.20
SURGEPILOT_E2E_NODE_SSH_PORT=22322
SURGEPILOT_SSH_E2E_PORT=22322

# P1 Monitoring node-facing InfluxDB write URL. This must be reachable from the
# Load Node network namespace and must not use compose DNS or host.docker.internal
# for real-IP acceptance evidence.
SURGEPILOT_MONITORING_INFLUXDB_NODE_WRITE_URL=http://192.168.1.20:18086
SURGEPILOT_MONITORING_INFLUXDB_HOST_PORT=18086

# Optional retention toggles for Makefile targets.
KEEP_DATA=1
KEEP_STACK=1

# Optional SSH Load Node image build proxies. These are consumed only by
# infra/docker/docker-compose.ssh-e2e.yml image build args.
# SURGEPILOT_DOCKER_BUILD_HTTP_PROXY=http://proxy.example.invalid:3128
# SURGEPILOT_DOCKER_BUILD_HTTPS_PROXY=http://proxy.example.invalid:3128
# SURGEPILOT_DOCKER_BUILD_NO_PROXY=localhost,127.0.0.1
