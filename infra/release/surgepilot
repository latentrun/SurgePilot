#!/bin/sh
set -eu

RELEASE_VERSION="@@RELEASE_VERSION@@"
API_IMAGE="@@API_IMAGE@@"
COMMAND_NAME=${SURGEPILOT_COMMAND_NAME:-./surgepilot}
SCRIPT_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
RELEASE_ROOT=${SURGEPILOT_RELEASE_ROOT:-$SCRIPT_ROOT}
DEPLOYMENT_ROOT=${SURGEPILOT_DEPLOYMENT_ROOT:-$RELEASE_ROOT}
ENV_FILE="$DEPLOYMENT_ROOT/.env"
INSTALLED_MODE=false
DEPLOYMENT_LOCK_DIR=
HELPER_TEMP_DIR=
HELPER_PASSWD=
HELPER_OUTPUT=
STATE_CANDIDATE=
RELEASE_PHASE=manual
RELEASE_BASE=none
TRANSITION_SOURCE=none
ACTIVE_SERVICE_CONTAINERS=

usage() {
    cat <<USAGE
Usage:
  $COMMAND_NAME up
  $COMMAND_NAME down
  $COMMAND_NAME status
  $COMMAND_NAME logs
USAGE
}

fail() {
    printf "SurgePilot: %s\n" "$*" >&2
    exit 1
}

cleanup_helper_passwd() {
    if [ -n "$HELPER_PASSWD" ]; then
        rm -f "$HELPER_PASSWD"
        HELPER_PASSWD=
    fi
}

cleanup_helper_output() {
    if [ -n "$HELPER_OUTPUT" ]; then
        rm -f "$HELPER_OUTPUT"
        HELPER_OUTPUT=
    fi
}

cleanup_helper_state() {
    cleanup_helper_passwd
    cleanup_helper_output
    if [ -n "$HELPER_TEMP_DIR" ]; then
        rm -rf "$HELPER_TEMP_DIR"
        HELPER_TEMP_DIR=
    fi
}

cleanup_deployment_lock() {
    if [ "$INSTALLED_MODE" != "true" ] || [ ! -d "$DEPLOYMENT_LOCK_DIR" ] || \
        [ -L "$DEPLOYMENT_LOCK_DIR" ] || [ ! -f "$DEPLOYMENT_LOCK_DIR/owner" ] || \
        [ -L "$DEPLOYMENT_LOCK_DIR/owner" ]; then
        return
    fi
    if [ "$(ls -A "$DEPLOYMENT_LOCK_DIR" 2>/dev/null)" = "owner" ] && \
        grep -q "^pid=$$\$" "$DEPLOYMENT_LOCK_DIR/owner" && \
        grep -q "^nonce=$SURGEPILOT_LOCK_NONCE\$" "$DEPLOYMENT_LOCK_DIR/owner"; then
        rm -f "$DEPLOYMENT_LOCK_DIR/owner"
        rmdir "$DEPLOYMENT_LOCK_DIR" 2>/dev/null || :
    fi
}

cleanup() {
    cleanup_helper_state
    if [ -n "$STATE_CANDIDATE" ]; then
        rm -f "$STATE_CANDIDATE"
        STATE_CANDIDATE=
    fi
    cleanup_deployment_lock
}

validate_dispatcher_context() {
    if [ "${SURGEPILOT_DEPLOYMENT_ROOT+x}" != x ]; then
        [ "${SURGEPILOT_RELEASE_ROOT+x}" != x ] && \
            [ "${SURGEPILOT_RELEASE_PHASE+x}" != x ] && \
            [ "${SURGEPILOT_RELEASE_TARGET+x}" != x ] && \
            [ "${SURGEPILOT_RELEASE_BASE+x}" != x ] && \
            [ "${SURGEPILOT_LOCK_NONCE+x}" != x ] && \
            [ "${SURGEPILOT_LOCK_PID+x}" != x ] || \
            fail "incomplete internal dispatcher context."
        return
    fi
    [ "${SURGEPILOT_RELEASE_ROOT+x}" = x ] && \
        [ "${SURGEPILOT_RELEASE_PHASE+x}" = x ] && \
        [ "${SURGEPILOT_RELEASE_TARGET+x}" = x ] && \
        [ "${SURGEPILOT_RELEASE_BASE+x}" = x ] && \
        [ "${SURGEPILOT_LOCK_NONCE+x}" = x ] && \
        [ "${SURGEPILOT_LOCK_PID+x}" = x ] || \
        fail "incomplete internal dispatcher context."
    [ "$SURGEPILOT_LOCK_PID" = "$$" ] || fail "internal deployment lock owner is invalid."
    [ -d "$DEPLOYMENT_ROOT" ] && [ ! -L "$DEPLOYMENT_ROOT" ] || \
        fail "internal deployment root is unsafe."
    DEPLOYMENT_LOCK_DIR="${DEPLOYMENT_ROOT}.lock"
    [ -d "$DEPLOYMENT_LOCK_DIR" ] && [ ! -L "$DEPLOYMENT_LOCK_DIR" ] && \
        [ -f "$DEPLOYMENT_LOCK_DIR/owner" ] && [ ! -L "$DEPLOYMENT_LOCK_DIR/owner" ] || \
        fail "internal deployment lock is unsafe."
    [ "$(ls -A "$DEPLOYMENT_LOCK_DIR" 2>/dev/null)" = "owner" ] || \
        fail "internal deployment lock contains unexpected entries."
    expected_owner=$(printf 'schema=1\npid=%s\nnonce=%s' "$$" "$SURGEPILOT_LOCK_NONCE")
    actual_owner=$(cat "$DEPLOYMENT_LOCK_DIR/owner")
    [ "$actual_owner" = "$expected_owner" ] || fail "internal deployment lock owner is invalid."
    INSTALLED_MODE=true
    [ "$RELEASE_ROOT" = "$SCRIPT_ROOT" ] || fail "internal release root does not match this wrapper."
    [ "$SURGEPILOT_RELEASE_TARGET" = "$RELEASE_VERSION" ] || \
        fail "internal release target does not match this wrapper."
    RELEASE_PHASE=$SURGEPILOT_RELEASE_PHASE
    RELEASE_BASE=$SURGEPILOT_RELEASE_BASE
    case "$RELEASE_PHASE:$RELEASE_BASE" in
        unclassified:none|prepared:none|migration_started:none|stable:*|installed:*) ;;
        unclassified:*|prepared:*|migration_started:*) TRANSITION_SOURCE=$RELEASE_BASE ;;
    esac
}

trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

validate_dispatcher_context

write_release_state() {
    next_phase=$1
    next_base=$2
    [ "$INSTALLED_MODE" = true ] || fail "release state is available only for installed releases."
    STATE_CANDIDATE=$(mktemp "$DEPLOYMENT_ROOT/.release-state.XXXXXX") || \
        fail "Cannot prepare release state."
    printf 'schema=1\nphase=%s\ntarget=%s\nbase=%s\n' \
        "$next_phase" "$RELEASE_VERSION" "$next_base" > "$STATE_CANDIDATE" || \
        fail "Cannot write release state."
    chmod 600 "$STATE_CANDIDATE" || fail "Cannot protect release state."
    sync || fail "Cannot confirm release state durability."
    mv "$STATE_CANDIDATE" "$DEPLOYMENT_ROOT/.release-state" || \
        fail "Cannot publish release state."
    STATE_CANDIDATE=
    sync || fail "Cannot confirm release state durability."
    RELEASE_PHASE=$next_phase
    RELEASE_BASE=$next_base
}

source_release_root() {
    printf '%s\n' "$DEPLOYMENT_ROOT/.releases/$RELEASE_BASE"
}

inspect_active_services() {
    inspect_root=$1
    inspect_version=$2
    shift 2
    ACTIVE_SERVICE_CONTAINERS=
    inspected_ids=$(compose_at "$inspect_root" "$inspect_version" ps -a -q "$@") || return 1
    for inspected_id in $inspected_ids; do
        inspected_state=$(docker inspect --format \
            '{{.State.Running}}|{{.State.Paused}}|{{.State.Restarting}}' \
            "$inspected_id") || return 1
        case "$inspected_state" in
            false\|false\|false) ;;
            true\|false\|false|true\|true\|false|true\|false\|true|false\|false\|true)
                ACTIVE_SERVICE_CONTAINERS="${ACTIVE_SERVICE_CONTAINERS}${ACTIVE_SERVICE_CONTAINERS:+ }$inspected_id"
                ;;
            *) return 1 ;;
        esac
    done
}

run_transition_probe() {
    probe_root=$1
    probe_version=$2
    probe_mode=$3
    probe_output=$(compose_at "$probe_root" "$probe_version" run --rm -T --no-deps \
        --volume "$RELEASE_ROOT/scripts/release_transition_probe.py:/tmp/release-transition-probe.py:ro" \
        api /app/.venv/bin/python /tmp/release-transition-probe.py "$probe_mode") || return 2
    [ "$(printf '%s\n' "$probe_output" | wc -l | tr -d ' ')" -eq 1 ] || return 2
    case "$probe_mode:$probe_output" in
        active-work:*'"status":"quiescent"'*) return 0 ;;
        active-work:*'"status":"blocked"'*) return 3 ;;
        classify:*'"classification":"empty"'*) return 10 ;;
        classify:*'"classification":"source"'*) return 11 ;;
        *) return 2 ;;
    esac
}

restore_source_stack() {
    restore_root=$1
    restore_version=$2
    printf 'SurgePilot: restoring source release %s after a pre-migration refusal.\n' \
        "$restore_version" >&2
    if ! compose_at "$restore_root" "$restore_version" up -d --wait \
        --wait-timeout "${SURGEPILOT_HEALTH_TIMEOUT_SECONDS:-300}"; then
        printf 'SurgePilot: source recovery failed; recover %s manually before retrying.\n' \
            "$restore_version" >&2
        return 1
    fi
    if ! validate_source_identity "$restore_root" "$restore_version"; then
        printf 'SurgePilot: restored source identity is invalid; recover %s manually.\n' \
            "$restore_version" >&2
        return 1
    fi
}

enter_prepared_transition() {
    source_root=$(source_release_root)
    source_version=$RELEASE_BASE
    [ -d "$source_root" ] && [ ! -L "$source_root" ] || \
        fail "Source release directory is missing or unsafe: $source_root"

    inspect_active_services "$source_root" "$source_version" api-migrate || \
        fail "Cannot prove source api-migrate state."
    if [ -n "$ACTIVE_SERVICE_CONTAINERS" ]; then
        fail "Source api-migrate is still running; wait for it to finish and retry."
    fi

    inspect_active_services "$source_root" "$source_version" nginx api-worker api || \
        fail "Cannot prove source ingress and writer state."
    if [ -n "$ACTIVE_SERVICE_CONTAINERS" ]; then
        if run_transition_probe "$source_root" "$source_version" active-work; then
            :
        else
            probe_status=$?
            if [ "$probe_status" -eq 3 ]; then
                fail "Active source work blocks this release transition; wait for it to finish."
            fi
            fail "The preliminary active-work probe failed closed."
        fi
        compose_at "$source_root" "$source_version" stop nginx || {
            restore_source_stack "$source_root" "$source_version" || :
            fail "Cannot stop source Nginx."
        }
        compose_at "$source_root" "$source_version" stop api-worker || {
            restore_source_stack "$source_root" "$source_version" || :
            fail "Cannot stop source api-worker."
        }
        compose_at "$source_root" "$source_version" stop api || {
            restore_source_stack "$source_root" "$source_version" || :
            fail "Cannot stop source API."
        }
    else
        if ! compose_at "$source_root" "$source_version" up -d --wait \
            --wait-timeout "${SURGEPILOT_HEALTH_TIMEOUT_SECONDS:-300}" postgres; then
            restore_source_stack "$source_root" "$source_version" || :
            fail "Cannot start source PostgreSQL for the final transition probe."
        fi
    fi

    if ! inspect_active_services "$source_root" "$source_version" nginx api-worker api; then
        restore_source_stack "$source_root" "$source_version" || :
        fail "Cannot prove source ingress and writer state after stop."
    fi
    if [ -n "$ACTIVE_SERVICE_CONTAINERS" ]; then
        restore_source_stack "$source_root" "$source_version" || :
        fail "Source ingress or writers remained running after stop."
    fi
    if ! inspect_active_services "$source_root" "$source_version" api-migrate; then
        restore_source_stack "$source_root" "$source_version" || :
        fail "Cannot prove source api-migrate state after stop."
    fi
    if [ -n "$ACTIVE_SERVICE_CONTAINERS" ]; then
        fail "Source api-migrate appeared during downtime; it was not stopped. Wait and retry."
    fi

    if run_transition_probe "$source_root" "$source_version" active-work; then
        :
    else
        probe_status=$?
        restore_source_stack "$source_root" "$source_version" || :
        if [ "$probe_status" -eq 3 ]; then
            fail "Active work was found by the authoritative probe; source release restored."
        fi
        fail "The authoritative active-work probe failed; source release restored."
    fi

    if ! inspect_active_services "$source_root" "$source_version" nginx api-worker api; then
        restore_source_stack "$source_root" "$source_version" || :
        fail "Cannot reverify source ingress and writer state before migration."
    fi
    if [ -n "$ACTIVE_SERVICE_CONTAINERS" ]; then
        restore_source_stack "$source_root" "$source_version" || :
        fail "A source writer reappeared before migration."
    fi
    if ! inspect_active_services "$source_root" "$source_version" api-migrate; then
        restore_source_stack "$source_root" "$source_version" || :
        fail "Cannot reverify source api-migrate state before migration."
    fi
    if [ -n "$ACTIVE_SERVICE_CONTAINERS" ]; then
        fail "Source api-migrate reappeared before migration; it was not stopped. Wait and retry."
    fi
    write_release_state migration_started "$source_version"
}

classify_legacy_database() {
    source_root=$(source_release_root)
    source_version=$RELEASE_BASE
    [ -d "$source_root" ] && [ ! -L "$source_root" ] || \
        fail "Source release directory is missing or unsafe: $source_root"
    inspect_active_services "$source_root" "$source_version" api-migrate || \
        fail "Cannot prove source api-migrate state for classification."
    if [ -n "$ACTIVE_SERVICE_CONTAINERS" ]; then
        fail "Source api-migrate is still running; wait for it to finish and retry."
    fi
    project_name=$(env_value COMPOSE_PROJECT_NAME)
    [ -n "$project_name" ] || project_name=surgepilot
    postgres_container=$(compose_at "$source_root" "$source_version" ps -a -q postgres) || \
        fail "Cannot inspect source PostgreSQL containers for legacy classification."
    postgres_volume=$(docker volume ls --quiet \
        --filter "name=${project_name}_postgres-data") || \
        fail "Cannot inspect the persisted PostgreSQL volume for legacy classification."
    case "$postgres_volume" in
        ''|"${project_name}_postgres-data") ;;
        *) fail "PostgreSQL volume classification returned an ambiguous result." ;;
    esac
    if [ -z "$postgres_container" ] && [ -z "$postgres_volume" ]; then
        write_release_state installed none
        return
    fi
    compose_at "$source_root" "$source_version" up -d --wait \
        --wait-timeout "${SURGEPILOT_HEALTH_TIMEOUT_SECONDS:-300}" postgres || \
        fail "Cannot start source PostgreSQL for legacy classification."
    if run_transition_probe "$source_root" "$source_version" classify; then
        fail "Legacy classification returned an unsupported success result."
    else
        classification_status=$?
    fi
    case "$classification_status" in
        10) write_release_state installed none ;;
        11) write_release_state prepared "$source_version" ;;
        *) fail "Legacy database classification failed closed." ;;
    esac
}

enter_installed_transition() {
    inspect_active_services "$RELEASE_ROOT" "$RELEASE_VERSION" nginx api-worker api || \
        fail "Cannot prove target ingress and writer state before first migration."
    if [ -n "$ACTIVE_SERVICE_CONTAINERS" ]; then
        fail "Existing ingress or writer containers must be stopped before first migration."
    fi
    inspect_active_services "$RELEASE_ROOT" "$RELEASE_VERSION" api-migrate || \
        fail "Cannot prove target api-migrate state before first migration."
    if [ -n "$ACTIVE_SERVICE_CONTAINERS" ]; then
        fail "Existing api-migrate is still running; wait for it to finish and retry."
    fi
    write_release_state migration_started none
}

require_docker() {
    command -v docker >/dev/null 2>&1 || fail "Docker Engine or Docker Desktop is required."
    docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is required."
    docker info >/dev/null 2>&1 || fail "The Docker daemon is not reachable."
}

require_minimum_version() {
    name=$1
    actual=$2
    minimum=$3
    actual_number=$(printf '%s\n' "$actual" | sed 's/^v//' | awk -F. '/^[0-9]+\.[0-9]+\.[0-9]+/ {printf "%d%03d%03d", $1, $2, $3}')
    minimum_number=$(printf '%s\n' "$minimum" | awk -F. '{printf "%d%03d%03d", $1, $2, $3}')
    if [ -z "$actual_number" ] || [ "$actual_number" -lt "$minimum_number" ]; then
        fail "$name $minimum or newer is required; found $actual"
    fi
}

env_value() {
    key=$1
    if [ ! -f "$ENV_FILE" ]; then
        return 0
    fi
    sed -n "s/^${key}=//p" "$ENV_FILE" | sed -n '$p' | sed "s/^'//;s/'$//"
}

is_local_only_origin() {
    case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        http://localhost:*|http://localhost.:*|http://127.0.0.1:*|http://127.0.0.1.:*|http://\[::1\]:*) return 0 ;;
        *) return 1 ;;
    esac
}

compose_at() {
    compose_release_root=$1
    compose_release_version=$2
    shift 2
    compose_file="$compose_release_root/compose/docker-compose.yml"
    [ -f "$compose_file" ] && [ ! -L "$compose_file" ] || \
        fail "Release Compose file is missing or unsafe: $compose_file"
    demo_enabled=$(env_value SURGEPILOT_DEMO_LOAD_NODE_ENABLED | tr '[:upper:]' '[:lower:]')
    if [ "$demo_enabled" = "true" ]; then
        LOAD_NODE_RUNTIME_VERSION="$compose_release_version" docker compose \
            --env-file "$ENV_FILE" -f "$compose_file" --profile demo "$@"
    else
        LOAD_NODE_RUNTIME_VERSION="$compose_release_version" docker compose \
            --env-file "$ENV_FILE" -f "$compose_file" "$@"
    fi
}

compose() {
    compose_at "$RELEASE_ROOT" "$RELEASE_VERSION" "$@"
}

lifecycle_compose() {
    if [ "$INSTALLED_MODE" = true ] && \
        { [ "$RELEASE_PHASE" = unclassified ] || [ "$RELEASE_PHASE" = prepared ]; }; then
        compose_at "$DEPLOYMENT_ROOT/.releases/$RELEASE_BASE" "$RELEASE_BASE" "$@"
    else
        compose "$@"
    fi
}

ensure_helper_temp_dir() {
    if [ -n "$HELPER_TEMP_DIR" ]; then
        return 0
    fi
    HELPER_TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/surgepilot-helper.XXXXXX") || \
        fail "Cannot prepare private helper state."
    chmod 700 "$HELPER_TEMP_DIR" || fail "Cannot protect private helper state."
}

helper() {
    ensure_helper_temp_dir
    HELPER_PASSWD=$(mktemp "$HELPER_TEMP_DIR/helper-passwd.XXXXXX") || \
        fail "Cannot prepare helper user identity."
    helper_uid=$(id -u)
    helper_gid=$(id -g)
    printf 'root:x:0:0:root:/root:/bin/sh\nsurgepilot-helper:x:%s:%s:SurgePilot helper:/tmp:/usr/sbin/nologin\n' \
        "$helper_uid" "$helper_gid" > "$HELPER_PASSWD"
    if docker run --rm \
        --user "$(id -u):$(id -g)" \
        --env HOME=/tmp \
        --env COMPOSE_PROJECT_NAME \
        --env DEFAULT_WORKSPACE_NAME \
        --env RUNNER_INTERNAL_TOKEN \
        --env SSH_CREDENTIAL_ENCRYPTION_KEY \
        --env MINIO_BUCKET \
        --env MINIO_ACCESS_KEY \
        --env MINIO_SECRET_KEY \
        --env MINIO_ROOT_USER \
        --env MINIO_ROOT_PASSWORD \
        --env SURGEPILOT_MONITORING_INFLUXDB_USERNAME \
        --env SURGEPILOT_MONITORING_INFLUXDB_PASSWORD \
        --env SURGEPILOT_MONITORING_INFLUXDB_TOKEN_FILE_HOST \
        --env SURGEPILOT_MONITORING_INFLUXDB_ORG \
        --env SURGEPILOT_MONITORING_INFLUXDB_BUCKET \
        --env SURGEPILOT_GRAFANA_ADMIN_USER \
        --volume "$RELEASE_ROOT:/release:ro" \
        --volume "$DEPLOYMENT_ROOT:/deployment" \
        --volume "$HELPER_PASSWD:/etc/passwd:ro" \
        --workdir /release \
        "$API_IMAGE" \
        /app/.venv/bin/python "$@" </dev/null; then
        helper_status=0
    else
        helper_status=$?
    fi
    cleanup_helper_passwd
    return "$helper_status"
}

reject_process_overrides() {
    if [ "${COMPOSE_PROJECT_NAME+x}" = x ] && [ -f "$ENV_FILE" ]; then
        fail "COMPOSE_PROJECT_NAME process-level overrides are not supported; edit .env instead."
    fi
    if [ "${COMPOSE_PROFILES+x}" = x ]; then
        fail "COMPOSE_PROFILES process-level overrides are not supported; edit .env instead."
    fi
    if [ "${COMPOSE_ENV_FILES+x}" = x ]; then
        fail "COMPOSE_ENV_FILES process-level overrides are not supported; edit .env instead."
    fi
    if [ "${LOAD_NODE_RUNTIME_ARTIFACT_HOST_DIR+x}" = x ]; then
        fail "LOAD_NODE_RUNTIME_ARTIFACT_HOST_DIR process-level overrides are not supported."
    fi
    if [ "${SURGEPILOT_MONITORING_INFLUXDB_TOKEN_FILE_HOST+x}" = x ] && \
        [ -f "$ENV_FILE" ]; then
        fail "SURGEPILOT_MONITORING_INFLUXDB_TOKEN_FILE_HOST process-level overrides are not supported; edit .env instead."
    fi
    if [ "${SURGEPILOT_HTTP_PORT+x}" = x ]; then
        fail "SURGEPILOT_HTTP_PORT process-level overrides are not supported; edit .env instead."
    fi
    if [ "${SURGEPILOT_NODE_API_BASE_URL+x}" = x ]; then
        fail "SURGEPILOT_NODE_API_BASE_URL process-level overrides are not supported; edit .env instead."
    fi
    if [ "${SURGEPILOT_MONITORING_INFLUXDB_HOST_PORT+x}" = x ]; then
        fail "SURGEPILOT_MONITORING_INFLUXDB_HOST_PORT process-level overrides are not supported; edit .env instead."
    fi
    if [ "${SURGEPILOT_MONITORING_INFLUXDB_NODE_WRITE_URL+x}" = x ]; then
        fail "SURGEPILOT_MONITORING_INFLUXDB_NODE_WRITE_URL process-level overrides are not supported; edit .env instead."
    fi
    if [ "${SURGEPILOT_RUNTIME_ARCHITECTURES+x}" = x ]; then
        fail "SURGEPILOT_RUNTIME_ARCHITECTURES process-level overrides are not supported; edit .env instead."
    fi
    if [ "${SURGEPILOT_DEMO_LOAD_NODE_ENABLED+x}" = x ]; then
        fail "SURGEPILOT_DEMO_LOAD_NODE_ENABLED process-level overrides are not supported; edit .env instead."
    fi
    if [ "${SESSION_COOKIE_SECURE+x}" = x ]; then
        fail "SESSION_COOKIE_SECURE process-level overrides are not supported; edit .env instead."
    fi
}

normalized_value() {
    key=$1
    value=$(sed -n "s/^${key}=//p" "$HELPER_OUTPUT" | sed -n '$p')
    [ -n "$value" ] || fail "Release bootstrap normalization did not return $key."
    printf '%s\n' "$value"
}

load_release_description() {
    ensure_helper_temp_dir
    HELPER_OUTPUT=$(mktemp "$HELPER_TEMP_DIR/helper-output.XXXXXX") || \
        fail "Cannot prepare helper output."
    if ! helper /opt/surgepilot/release-tools/release_preflight.py describe-release \
        --root /release \
        --deployment-root /deployment \
        --expected-version "$RELEASE_VERSION" \
        --daemon-arch "$daemon_arch" \
        --forced-platform "${DOCKER_DEFAULT_PLATFORM:-}" > "$HELPER_OUTPUT"; then
        cat "$HELPER_OUTPUT" >&2 || true
        cleanup_helper_output
        fail "Existing release configuration is invalid."
    fi

    config_mode=$(normalized_value SURGEPILOT_CONFIG_MODE)
    config_host=$(sed -n 's/^SURGEPILOT_CONFIG_HOST=//p' "$HELPER_OUTPUT" | sed -n '$p')
    http_port=$(normalized_value SURGEPILOT_HTTP_PORT)
    api_url=$(normalized_value SURGEPILOT_NODE_API_BASE_URL)
    influx_port=$(normalized_value SURGEPILOT_MONITORING_INFLUXDB_HOST_PORT)
    influx_url=$(normalized_value SURGEPILOT_MONITORING_INFLUXDB_NODE_WRITE_URL)
    configured_architectures=$(normalized_value SURGEPILOT_RUNTIME_ARCHITECTURES)
    architectures=$(normalized_value SURGEPILOT_SELECTED_RUNTIME_ARCHITECTURES)
    demo_enabled=$(normalized_value SURGEPILOT_DEMO_LOAD_NODE_ENABLED)
    env_sha256=$(normalized_value SURGEPILOT_ENV_SHA256)
    cleanup_helper_output
}

load_release_identity() {
    identity_root=$1
    identity_expected_version=$2
    identity_manifest_mode=${3:-current}
    ensure_helper_temp_dir
    HELPER_OUTPUT=$(mktemp "$HELPER_TEMP_DIR/helper-output.XXXXXX") || \
        fail "Cannot prepare helper output."
    if [ "$identity_manifest_mode" = legacy ]; then
        helper /opt/surgepilot/release-tools/release_preflight.py describe-identity \
            --root "$identity_root" --expected-version "$identity_expected_version" \
            --allow-legacy-manifest > "$HELPER_OUTPUT" || fail "Cannot read release identity."
    else
        helper /opt/surgepilot/release-tools/release_preflight.py describe-identity \
            --root "$identity_root" --expected-version "$identity_expected_version" > \
            "$HELPER_OUTPUT" || fail "Cannot read release identity."
    fi
    identity_version=$(normalized_value SURGEPILOT_IDENTITY_VERSION)
    identity_revision=$(normalized_value SURGEPILOT_IDENTITY_REVISION)
    identity_api_image=$(normalized_value SURGEPILOT_IDENTITY_API_IMAGE)
    identity_web_image=$(normalized_value SURGEPILOT_IDENTITY_WEB_IMAGE)
    identity_demo_image=$(normalized_value SURGEPILOT_IDENTITY_DEMO_IMAGE)
    cleanup_helper_output
}

validate_owned_service_identity() {
    identity_release_root=$1
    identity_release_version=$2
    service=$3
    expected_image=$4
    container_ids=$(compose_at "$identity_release_root" "$identity_release_version" ps -q "$service")
    [ -n "$container_ids" ] && [ "$(printf '%s\n' "$container_ids" | wc -l | tr -d ' ')" -eq 1 ] || \
        fail "Target service $service does not have exactly one running container."
    project_name=$(env_value COMPOSE_PROJECT_NAME)
    [ -n "$project_name" ] || project_name=surgepilot
    container_identity=$(docker inspect --format \
        '{{.Config.Image}}|{{ index .Config.Labels "com.docker.compose.project" }}|{{ index .Config.Labels "com.docker.compose.service" }}' \
        "$container_ids") || fail "Cannot inspect target service $service."
    [ "$container_identity" = "$expected_image|$project_name|$service" ] || \
        fail "Target service $service image or Compose identity is incorrect."
    oci_identity=$(docker inspect --format \
        '{{ index .Config.Labels "org.opencontainers.image.version" }}|{{ index .Config.Labels "org.opencontainers.image.revision" }}' \
        "$container_ids") || fail "Cannot inspect target OCI identity for $service."
    [ "$oci_identity" = "$identity_version|$identity_revision" ] || \
        fail "Target service $service OCI identity is incorrect."
}

validate_api_product_identity() {
    identity_release_root=$1
    identity_release_version=$2
    expected_product_version=$3
    product_version=$(compose_at "$identity_release_root" "$identity_release_version" exec -T \
        api /app/.venv/bin/python -c \
        'from importlib.metadata import version; import json, urllib.request; data=json.load(urllib.request.urlopen("http://127.0.0.1:8000/api/readyz", timeout=10)); assert data.get("status") == "ready"; print(version("surgepilot-api"))') || \
        fail "API readiness and product-version probe failed."
    [ "$product_version" = "$expected_product_version" ] || \
        fail "API product version is incorrect."
}

validate_target_identity() {
    for path in .env.example README.md VERSION release-manifest.json surgepilot \
        surgepilot-dispatcher compose/docker-compose.yml scripts/__init__.py \
        scripts/bootstrap_deployment_env.py scripts/fetch_runtime_release.py \
        scripts/release_preflight.py scripts/release_transition_probe.py \
        compose/grafana/dashboards/surgepilot-jmeter-13644.json \
        compose/grafana/entrypoint.sh \
        compose/grafana/provisioning/dashboards/surgepilot.yml \
        compose/grafana/provisioning/datasources/influxdb.yml \
        compose/minio/init-bucket.sh compose/nginx/default.conf
    do
        [ -f "$RELEASE_ROOT/$path" ] && [ ! -L "$RELEASE_ROOT/$path" ] || \
            fail "Target release path is missing or unsafe: $path"
    done
    for path in compose compose/grafana compose/grafana/dashboards \
        compose/grafana/provisioning compose/grafana/provisioning/dashboards \
        compose/grafana/provisioning/datasources compose/minio compose/nginx scripts
    do
        [ -d "$RELEASE_ROOT/$path" ] && [ ! -L "$RELEASE_ROOT/$path" ] || \
            fail "Target release directory is missing or unsafe: $path"
    done
    [ -x "$RELEASE_ROOT/surgepilot" ] && [ -x "$RELEASE_ROOT/surgepilot-dispatcher" ] || \
        fail "Target release executables are unsafe."
    [ "$(cat "$RELEASE_ROOT/VERSION")" = "$RELEASE_VERSION" ] || \
        fail "Target VERSION does not match release state."
    if [ "$INSTALLED_MODE" = true ]; then
        [ -L "$RELEASE_ROOT/.surgepilot" ] && \
            [ "$(readlink "$RELEASE_ROOT/.surgepilot")" = ../../.surgepilot ] || \
            fail "Target private-state bridge is invalid."
    fi
    load_release_identity /release "$RELEASE_VERSION"
    [ "$identity_version" = "$RELEASE_VERSION" ] || fail "Target manifest version is incorrect."
    validate_owned_service_identity "$RELEASE_ROOT" "$RELEASE_VERSION" api "$identity_api_image"
    validate_owned_service_identity \
        "$RELEASE_ROOT" "$RELEASE_VERSION" api-worker "$identity_api_image"
    validate_owned_service_identity "$RELEASE_ROOT" "$RELEASE_VERSION" web "$identity_web_image"
    if [ "$(env_value SURGEPILOT_DEMO_LOAD_NODE_ENABLED | tr '[:upper:]' '[:lower:]')" = true ]; then
        validate_owned_service_identity \
            "$RELEASE_ROOT" "$RELEASE_VERSION" demo-load-node "$identity_demo_image"
    fi
    validate_api_product_identity "$RELEASE_ROOT" "$RELEASE_VERSION" "${RELEASE_VERSION#v}"
}

validate_source_identity() {
    source_identity_root=$1
    source_identity_version=$2
    case "$source_identity_version" in
        v1.0.0) source_product_version=0.1.0 ;;
        v1.1.0) source_product_version=1.1.0 ;;
        *) source_product_version=${source_identity_version#v} ;;
    esac
    load_release_identity "/deployment/.releases/$source_identity_version" \
        "$source_identity_version" legacy
    [ "$identity_version" = "$source_identity_version" ] || \
        fail "Restored source manifest version is incorrect."
    validate_owned_service_identity \
        "$source_identity_root" "$source_identity_version" api "$identity_api_image"
    validate_owned_service_identity \
        "$source_identity_root" "$source_identity_version" api-worker "$identity_api_image"
    validate_owned_service_identity \
        "$source_identity_root" "$source_identity_version" web "$identity_web_image"
    if [ "$(env_value SURGEPILOT_DEMO_LOAD_NODE_ENABLED | tr '[:upper:]' '[:lower:]')" = true ]; then
        validate_owned_service_identity "$source_identity_root" "$source_identity_version" \
            demo-load-node "$identity_demo_image"
    fi
    validate_api_product_identity \
        "$source_identity_root" "$source_identity_version" "$source_product_version"
}

print_release_summary() {
    printf "\nWeb and API: %s\n" "$api_url"
    printf "InfluxDB node write: %s\n" "$influx_url"
    printf "Runtime architectures: %s\n" "$configured_architectures"
    case "$(printf '%s' "$demo_enabled" | tr '[:upper:]' '[:lower:]')" in
        true) printf "Demo Load Node: enabled\n" ;;
        *) printf "Demo Load Node: disabled\n" ;;
    esac
    if is_local_only_origin "$api_url"; then
        printf "Configured node-facing URLs: this computer only.\n"
        printf "Warning: other computers and external Load Nodes cannot reach these configured URLs.\n"
        printf "Docker still publishes these ports on host interfaces; use the host firewall if local-only network exposure is required.\n"
    fi
}

confirm_release_summary() {
    while true; do
        printf "Use this configuration? [Y/n]: "
        IFS= read -r confirmation || fail "Release configuration confirmation ended unexpectedly."
        confirmation=$(printf '%s' "$confirmation" | tr '[:upper:]' '[:lower:]')
        case "$confirmation" in
            ''|y|yes) return 0 ;;
            n|no) return 1 ;;
            *) printf "Please enter y or n.\n" ;;
        esac
    done
}

collect_lan_proposal() {
    default_host=$1
    default_http_port=$2
    default_influx_port=$3
    proposal_architectures=$4

    if [ -n "$default_host" ]; then
        printf "LAN host or IP [%s]: " "$default_host"
    else
        printf "LAN host or IP [required]: "
    fi
    IFS= read -r lan_host || fail "LAN host or IP input ended unexpectedly."
    if [ -z "$lan_host" ]; then lan_host=$default_host; fi
    [ -n "$lan_host" ] || fail "LAN host or IP is required."

    printf "HTTP port [%s]: " "$default_http_port"
    IFS= read -r proposal_http_port || fail "HTTP port input ended unexpectedly."
    if [ -z "$proposal_http_port" ]; then proposal_http_port=$default_http_port; fi
    printf "InfluxDB node-write port [%s]: " "$default_influx_port"
    IFS= read -r proposal_influx_port || fail "InfluxDB port input ended unexpectedly."
    if [ -z "$proposal_influx_port" ]; then proposal_influx_port=$default_influx_port; fi

    ensure_helper_temp_dir
    HELPER_OUTPUT=$(mktemp "$HELPER_TEMP_DIR/helper-output.XXXXXX") || \
        fail "Cannot prepare helper output."
    if helper /opt/surgepilot/release-tools/release_preflight.py normalize-bootstrap \
        --host "$lan_host" \
        --http-port "$proposal_http_port" \
        --influx-port "$proposal_influx_port" \
        --runtime-architectures "$proposal_architectures" \
        --daemon-arch "$daemon_arch" \
        --forced-platform "${DOCKER_DEFAULT_PLATFORM:-}" > "$HELPER_OUTPUT"; then
        proposal_status=0
    else
        proposal_status=$?
    fi
    if [ "$proposal_status" -ne 0 ]; then
        cat "$HELPER_OUTPUT" >&2 || true
        cleanup_helper_output
        return "$proposal_status"
    fi

    http_port=$(normalized_value SURGEPILOT_HTTP_PORT)
    api_url=$(normalized_value SURGEPILOT_NODE_API_BASE_URL)
    influx_port=$(normalized_value SURGEPILOT_MONITORING_INFLUXDB_HOST_PORT)
    influx_url=$(normalized_value SURGEPILOT_MONITORING_INFLUXDB_NODE_WRITE_URL)
    cleanup_helper_output
}

check_required_port() {
    label=$1
    port=$2
    case "$port" in
        ''|*[!0-9]*)
            printf "SurgePilot: %s host port must be an integer; found %s\n" \
                "$label" "${port:-<empty>}" >&2
            return 1
            ;;
    esac
    if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
        printf "SurgePilot: %s host port must be between 1 and 65535; found %s\n" \
            "$label" "$port" >&2
        return 1
    fi
    if ! docker run --rm --publish "$port:80" "$API_IMAGE" /usr/bin/true >/dev/null 2>&1; then
        project_name=${COMPOSE_PROJECT_NAME:-$(env_value COMPOSE_PROJECT_NAME)}
        if [ -z "$project_name" ]; then project_name=surgepilot; fi
        owned_ports=$(docker ps \
            --filter "label=com.docker.compose.project=$project_name" \
            --format "{{.Ports}}" 2>/dev/null || true)
        if ! printf '%s\n' "$owned_ports" | grep -Eq "(^|[ ,])([^,]*:)?${port}->"; then
            printf "SurgePilot: %s host port %s is unavailable; choose another persisted port before retrying.\n" \
                "$label" "$port" >&2
            return 1
        fi
    fi
}

warn_resources() {
    memory=$(docker info --format "{{.MemTotal}}" 2>/dev/null || printf 0)
    case "$memory" in *[!0-9]*|'') memory=0 ;; esac
    if [ "$memory" -gt 0 ] && [ "$memory" -lt 7516192768 ]; then
        printf "Warning: the complete SurgePilot stack has less than 7 GiB of Docker memory available.\n" >&2
    fi
}

up() {
    reject_process_overrides
    require_docker
    engine_version=$(docker version --format "{{.Server.Version}}")
    compose_version=$(docker compose version --short)
    daemon_arch=$(docker info --format "{{.Architecture}}")
    require_minimum_version "Docker Engine" "$engine_version" "26.0.0"
    require_minimum_version "Docker Compose" "$compose_version" "2.27.0"
    warn_resources

    first_run=false
    if [ ! -f "$ENV_FILE" ]; then
        first_run=true
        if [ ! -t 0 ] || [ ! -t 1 ]; then
            fail "first-run release setup requires an interactive terminal. Create and validate .env before running non-interactively."
        fi
    fi

    docker pull "$API_IMAGE"
    helper /opt/surgepilot/release-tools/release_preflight.py preflight \
        --root /release \
        --expected-version "$RELEASE_VERSION" \
        --engine-version "$engine_version" \
        --compose-version "$compose_version" \
        --daemon-arch "$daemon_arch"

    if [ "$first_run" = "true" ]; then
        demo_enabled=false
        configured_architectures=amd64,arm64
        cookie_secure=false
        while true; do
            if collect_lan_proposal "" 8080 8086 amd64,arm64; then
                :
            else
                proposal_status=$?
                if [ "$proposal_status" -eq 2 ]; then
                    continue
                fi
                exit "$proposal_status"
            fi
            print_release_summary
            if ! confirm_release_summary; then
                continue
            fi
            if ! check_required_port "SurgePilot HTTP" "$http_port"; then
                continue
            fi
            if ! check_required_port "InfluxDB" "$influx_port"; then
                continue
            fi
            helper /opt/surgepilot/release-tools/bootstrap_deployment_env.py \
                --root /release \
                --deployment-root /deployment \
                --release-http-port "$http_port" \
                --release-node-api-base-url "$api_url" \
                --release-influxdb-host-port "$influx_port" \
                --release-influxdb-node-write-url "$influx_url" \
                --release-demo-enabled "$demo_enabled" \
                --release-runtime-architectures "$configured_architectures" \
                --session-cookie-secure "$cookie_secure"
            break
        done
    else
        load_release_description
        print_release_summary
        if [ -t 0 ] && [ -t 1 ]; then
            if ! confirm_release_summary; then
                if [ "$config_mode" = "advanced_https" ]; then
                    printf "SurgePilot: Advanced HTTPS configuration cannot be changed by this prompt.\n" >&2
                    printf "SurgePilot: Edit .env explicitly, then run %s up again.\n" "$COMMAND_NAME" >&2
                    exit 1
                fi
                current_config_host=$config_host
                current_http_port=$http_port
                current_influx_port=$influx_port
                current_architectures=$configured_architectures
                while true; do
                    if collect_lan_proposal \
                        "$current_config_host" "$current_http_port" "$current_influx_port" \
                        "$current_architectures"; then
                        :
                    else
                        proposal_status=$?
                        if [ "$proposal_status" -eq 2 ]; then
                            continue
                        fi
                        exit "$proposal_status"
                    fi
                    print_release_summary
                    if ! confirm_release_summary; then
                        continue
                    fi
                    if ! check_required_port "SurgePilot HTTP" "$http_port"; then
                        continue
                    fi
                    if ! check_required_port "InfluxDB" "$influx_port"; then
                        continue
                    fi
                    helper /opt/surgepilot/release-tools/bootstrap_deployment_env.py \
                        --root /release \
                        --deployment-root /deployment \
                        --reconfigure-release-network \
                        --daemon-arch "$daemon_arch" \
                        --forced-platform "${DOCKER_DEFAULT_PLATFORM:-}" \
                        --expected-env-sha256 "$env_sha256" \
                        --release-http-port "$http_port" \
                        --release-node-api-base-url "$api_url" \
                        --release-influxdb-host-port "$influx_port" \
                        --release-influxdb-node-write-url "$influx_url"
                    load_release_description
                    break
                done
            fi
        fi

        check_required_port "SurgePilot HTTP" "$http_port"
        check_required_port "InfluxDB" "$influx_port"
        helper /opt/surgepilot/release-tools/bootstrap_deployment_env.py \
            --root /release --deployment-root /deployment
    fi

    if [ "$first_run" = "true" ]; then
        ensure_helper_temp_dir
        HELPER_OUTPUT=$(mktemp "$HELPER_TEMP_DIR/helper-output.XXXXXX") || \
            fail "Cannot prepare helper output."
        helper /opt/surgepilot/release-tools/release_preflight.py select-runtime \
            --root /release \
            --deployment-root /deployment \
            --expected-version "$RELEASE_VERSION" \
            --daemon-arch "$daemon_arch" \
            --forced-platform "${DOCKER_DEFAULT_PLATFORM:-}" > "$HELPER_OUTPUT"
        architectures=$(cat "$HELPER_OUTPUT")
        cleanup_helper_output
    fi

    helper /opt/surgepilot/release-tools/fetch_runtime_release.py \
        --root /release \
        --version "$RELEASE_VERSION" \
        --architectures "$architectures" \
        --target-directory /deployment/.surgepilot/runtime-artifacts \
        --env-host-directory "$DEPLOYMENT_ROOT/.surgepilot/runtime-artifacts"

    export LOAD_NODE_RUNTIME_VERSION="$RELEASE_VERSION"
    compose config >/dev/null
    compose pull
    if [ "$INSTALLED_MODE" = true ] && [ "$RELEASE_PHASE" = unclassified ]; then
        classify_legacy_database
    fi
    if [ "$INSTALLED_MODE" = true ] && [ "$RELEASE_PHASE" = prepared ]; then
        enter_prepared_transition
    fi
    if [ "$INSTALLED_MODE" = true ] && [ "$RELEASE_PHASE" = installed ]; then
        enter_installed_transition
    fi
    if ! compose up -d --wait --wait-timeout "${SURGEPILOT_HEALTH_TIMEOUT_SECONDS:-300}"; then
        printf "SurgePilot: the release stack did not become healthy. Current service state:\n" >&2
        compose ps >&2 || true
        printf "Run %s status and %s logs for bounded diagnostics.\n" \
            "$COMMAND_NAME" "$COMMAND_NAME" >&2
        exit 1
    fi
    if [ "$INSTALLED_MODE" = true ] && [ "$RELEASE_PHASE" = migration_started ]; then
        validate_target_identity
        write_release_state stable "$RELEASE_VERSION"
    fi

    api_url=$(env_value SURGEPILOT_NODE_API_BASE_URL)
    influx_url=$(env_value SURGEPILOT_MONITORING_INFLUXDB_NODE_WRITE_URL)
    cookie_secure=$(env_value SESSION_COOKIE_SECURE | tr '[:upper:]' '[:lower:]')
    printf "SurgePilot %s is ready.\n" "$RELEASE_VERSION"
    printf "Web: %s\n" "$api_url"
    printf "Grafana: %s/grafana/\n" "$api_url"
    if is_local_only_origin "$api_url"; then
        printf "Configured node-facing URLs: this computer only.\n"
        printf "Docker still publishes these ports on host interfaces; use the host firewall if local-only network exposure is required.\n"
        printf "SurgePilot: external Load Nodes are unavailable with loopback URLs. Update both node-facing URLs in .env before using them.\n" >&2
    else
        printf "External Load Nodes must reach:\n"
        printf "  API: %s\n" "$api_url"
        printf "  InfluxDB: %s\n" "$influx_url"
    fi
    printf "Commands: %s status | %s logs | %s down\n" \
        "$COMMAND_NAME" "$COMMAND_NAME" "$COMMAND_NAME"
    if [ "$TRANSITION_SOURCE" != none ]; then
        printf "Load Nodes that still report Runtime %s must be explicitly reinitialized for %s before new Runs are execution-ready.\n" \
            "$TRANSITION_SOURCE" "$RELEASE_VERSION"
    fi
    if [ "$cookie_secure" = "false" ]; then
        printf "Warning: direct HTTP is intended for a trusted LAN and does not provide transport encryption.\n" >&2
    fi
    if [ "$(env_value SURGEPILOT_DEMO_LOAD_NODE_ENABLED | tr '[:upper:]' '[:lower:]')" = "true" ]; then
        printf "Demo Load Node: host=demo-load-node port=22 username=surgepilot\n"
        printf "Demo password file: %s/.surgepilot/secrets/demo-load-node-password.secret\n" "$DEPLOYMENT_ROOT"
        printf "Demo SSH public key: %s/.surgepilot/demo-load-node/ssh_host_ed25519_key.pub\n" "$DEPLOYMENT_ROOT"
    fi
}

command=${1:-}
case "$command" in
    up)
        [ "$#" -eq 1 ] || fail "up does not accept additional arguments"
        up
        ;;
    down)
        [ "$#" -eq 1 ] || fail "down does not accept additional arguments"
        reject_process_overrides
        require_docker
        [ -f "$ENV_FILE" ] || fail "No deployment .env exists; run $COMMAND_NAME up first."
        lifecycle_compose down
        ;;
    status)
        [ "$#" -eq 1 ] || fail "status does not accept additional arguments"
        reject_process_overrides
        if [ "$INSTALLED_MODE" = true ]; then
            printf 'Release transition: phase=%s target=%s base=%s\n' \
                "$RELEASE_PHASE" "$RELEASE_VERSION" "$RELEASE_BASE"
            if [ ! -f "$ENV_FILE" ] && [ "$RELEASE_PHASE" = installed ]; then
                printf 'Deployment: not configured; run %s up to complete first deployment.\n' \
                    "$COMMAND_NAME"
                exit 0
            fi
        fi
        require_docker
        [ -f "$ENV_FILE" ] || fail "No deployment .env exists; run $COMMAND_NAME up first."
        lifecycle_compose ps
        ;;
    logs)
        [ "$#" -eq 1 ] || fail "logs does not accept additional arguments"
        reject_process_overrides
        require_docker
        [ -f "$ENV_FILE" ] || fail "No deployment .env exists; run $COMMAND_NAME up first."
        lifecycle_compose logs --tail 200
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
