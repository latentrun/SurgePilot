# SurgePilot deployment configuration.
# Official full-stack startup creates root .env from this template on the first run.
# Explicit bootstrap credentials in the process environment are persisted before missing values
# are generated, so later starts keep the same deployment identity and encryption material.
# Later process-level bootstrap credentials must match the persisted root .env values.
# For direct host development, run: python3 scripts/bootstrap_deployment_env.py
# Ordinary startup reads only the root .env. Test overrides live in .env.e2e.example.

# Quickstart ports and bootstrap identity
COMPOSE_PROJECT_NAME=surgepilot
SURGEPILOT_HTTP_PORT=8080
POSTGRES_HOST_PORT=5432
SURGEPILOT_API_HOST_PORT=8000
DEFAULT_WORKSPACE_NAME=Default Workspace

# Complete-stack Demo Load Node and Runtime acquisition.
# The Demo password and SSH host key are generated under private .surgepilot state.
SURGEPILOT_DEMO_LOAD_NODE_ENABLED=true
SURGEPILOT_RUNTIME_ARCHITECTURES=auto

# Bootstrap secrets
# Generate once with: openssl rand -hex 32
RUNNER_INTERNAL_TOKEN=replace-with-random-runner-token
# Generate once with: openssl rand -base64 32
# Keep this value stable while reusing database volumes. Existing Load Node credentials
# cannot be decrypted if this key is lost or changed.
SSH_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Direct host development. Compose uses fixed container-internal topology instead.
APP_ENV=development
DATABASE_URL=postgresql://surgepilot:surgepilot@localhost:5432/surgepilot
MINIO_ENDPOINT=http://localhost:9000

# MinIO deployment bootstrap
# MINIO_ACCESS_KEY must match MINIO_ROOT_USER, and MINIO_SECRET_KEY must match
# MINIO_ROOT_PASSWORD for the bundled MinIO service and bucket initializer.
MINIO_BUCKET=surgepilot
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-minio-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-minio-password
# MINIO_REGION=
# MINIO_SECURE=false

# P1 Monitoring deployment bootstrap
# Replace the example token file for non-development deployments. The container-side
# secret path is fixed by Compose and is not configured here.
SURGEPILOT_MONITORING_INFLUXDB_USERNAME=surgepilot
SURGEPILOT_MONITORING_INFLUXDB_PASSWORD=replace-with-influxdb-password
SURGEPILOT_MONITORING_INFLUXDB_HOST_PORT=8086
SURGEPILOT_MONITORING_INFLUXDB_TOKEN_FILE_HOST=./monitoring/influxdb-token.example
SURGEPILOT_MONITORING_INFLUXDB_ORG=surgepilot
SURGEPILOT_MONITORING_INFLUXDB_BUCKET=jmeter
SURGEPILOT_GRAFANA_ADMIN_USER=admin
# SURGEPILOT_GRAFANA_ROOT_URL=%(protocol)s://%(domain)s:%(http_port)s/grafana/
# SURGEPILOT_MONITORING_DASHBOARD_UID=surgepilot-jmeter-13644
# SURGEPILOT_MONITORING_DASHBOARD_SLUG=jmeter-load-test
# SURGEPILOT_MONITORING_ENABLED=false
# SURGEPILOT_MONITORING_INFLUXDB_TOKEN_CONFIGURED=false
# SURGEPILOT_MONITORING_GRAFANA_BASE_PATH=/grafana
# SURGEPILOT_MONITORING_TIME_PADDING_SECONDS=60

# Generated Load Node runtime values
# make release-runtime writes these values to .surgepilot/runtime-artifacts/.../runtime.env.
# make start-full-stack and make restart-full-stack source that file automatically.
# Set commented values manually only when bypassing the official startup path.
# LOAD_NODE_RUNTIME_VERSION=
# LOAD_NODE_RUNTIME_ARTIFACT_HOST_DIR=/absolute/path/to/.surgepilot/runtime-artifacts/default
# SURGEPILOT_SKIP_RUNTIME_PREFLIGHT=1
# RUNTIME_JMETER_SHA256=
# RUNTIME_CASUTG_SHA256=
# RUNTIME_JSON_SHA256=
# RUNTIME_TST_SHA256=
# RUNTIME_RANDOM_CSV_SHA256=
# RUNTIME_INFLUXDB2_LISTENER_SHA256=

# Optional Docker image build mirrors. Leave commented to use upstream defaults.
# SURGEPILOT_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# SURGEPILOT_NPM_REGISTRY=https://registry.npmmirror.com/
# SURGEPILOT_DOCKER_BUILD_UBUNTU_APT_MIRROR=http://example.invalid/ubuntu
# SURGEPILOT_DOCKER_BUILD_UBUNTU_APT_SECURITY_MIRROR=http://example.invalid/ubuntu
# SURGEPILOT_DOCKER_BUILD_DEBIAN_APT_MIRROR=http://example.invalid/debian
# SURGEPILOT_DOCKER_BUILD_DEBIAN_APT_SECURITY_MIRROR=http://example.invalid/debian-security
# Web build-time seed only. Runtime Web uses same-origin /api.
# VITE_API_BASE_URL=http://localhost:8000/api

# Advanced node-facing final URL overrides. Set both final origins for every external
# Load Node. The default complete stack uses Compose-internal origins for its Demo node.
# SURGEPILOT_NODE_API_BASE_URL=http://192.168.1.20:8080
# SURGEPILOT_MONITORING_INFLUXDB_NODE_WRITE_URL=http://192.168.1.20:8086

# DB-backed System Settings fallbacks
# These values apply only when the corresponding DB setting is absent. Manage normal
# policy changes in Admin -> System Settings instead of editing deployment env.
# ALLOW_SIGNUP=true
# DEPENDENCY_FILE_MAX_BYTES=104857600
# DEPENDENCY_FILE_ALLOWED_EXTENSIONS=
# DEPENDENCY_FILE_PREVIEW_MAX_BYTES=65536
# DEPENDENCY_FILE_PREVIEW_BINARY_DENY_EXTENSIONS=.png,.jpg,.jpeg,.gif,.webp,.bmp,.ico,.svg,.pdf,.zip,.tar,.gz,.tgz,.bz2,.xz,.7z,.rar,.jar,.war,.class,.so,.dll,.dylib,.exe,.bin,.dat,.woff,.woff2,.ttf,.otf,.eot,.mp3,.mp4,.mov,.avi,.mkv,.webm
# SURGEPILOT_MAX_SCENARIO_ITEMS_PER_TEST_PLAN=20
# SURGEPILOT_SINGLE_NODE_CONCURRENCY_SOFT_LIMIT=1000
# SURGEPILOT_MAX_RUN_DURATION_SECONDS=86400
# SURGEPILOT_MAX_RAMP_UP_SECONDS=86400
# SURGEPILOT_MAX_DELAY_SECONDS=86400
# SURGEPILOT_MAX_ITERATIONS=1000000
# SURGEPILOT_MAX_TARGET_RPS=100000
# SURGEPILOT_MAX_SLA_RULES_PER_TEST_PLAN=5
# SURGEPILOT_JMETER_MEMORY_XMX=4G

# Advanced deployment guardrails
# Change only with operational evidence. These values require process/stack restart.
# LOAD_NODE_INIT_COMMAND_TIMEOUT_SECONDS=30
# LOAD_NODE_RUNTIME_INSTALL_TIMEOUT_SECONDS=120
# LOAD_NODE_DEFAULT_RUNNER_HOME=/opt/surgepilot/runner
